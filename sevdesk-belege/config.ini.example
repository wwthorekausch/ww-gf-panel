; Keine Secrets. Token liegt in macOS Keychain (Service ww-gf-cockpit-sevdesk).
[grenzen]
usd_toleranz_prozent = 3
tage_vorher = 5
tage_nachher = 45
max_betrag = 2000
min_historie = 2
; "aus" = Lohn/Krankenkasse/Miete ohne Vormonatsvergleich buchen
lohn_toleranz_prozent = aus
gebuehren_max = 100
; mehrere passende Zahlungen (Monatsabos): genau eine in ±N Tagen um Belegdatum wird genommen
tage_eindeutig = 5

[aliase]
; Lieferant (wie in GetMyInvoices) = Name(n) auf dem Kontoauszug, kommagetrennt
plentymarkets = PlentyONE

[kategorien]
; AccountingType-IDs, die GetMyInvoices als Platzhalter setzt — gelten als "leer" und werden korrigiert
standard_ids =

[steuerarten]
; Regex auf Zahlungstext = AccountingType-ID; "pruefen" = nie automatisch. Genau eine Art muss passen.
ums\.?\s?st|umsatzsteuer = 3
lohnst = 25230
koerpst|körperschaftst = 35738
gewerbesteuer = 86
kfz-steuer = 7
s(ä|ae)umnis|versp(ä|ae)tungszuschlag = 26362
skapst|solskap|kistkap|kapitalertrag = pruefen
